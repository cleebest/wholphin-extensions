+/**
+ * Swap the interleaved U and V samples in a chroma plane (NV21-style output).
+ *
+ * width_bytes is the number of bytes per chroma row; bytes_per_sample is 1
+ * for 8-bit NV12 and 2 for 16-bit P010.
+ */
+static void swap_uv_plane(uint8_t *data, int linesize,
+                          int width_bytes, int height, int bytes_per_sample)
+{
+    for (int y = 0; y < height; y++) {
+        uint8_t *row = data + y * linesize;
+        for (int x = 0; x + 2 * bytes_per_sample <= width_bytes;
+             x += 2 * bytes_per_sample) {
+            for (int b = 0; b < bytes_per_sample; b++) {
+                uint8_t tmp = row[x + b];
+                row[x + b] = row[x + bytes_per_sample + b];
+                row[x + bytes_per_sample + b] = tmp;
+            }
+        }
+    }
+}

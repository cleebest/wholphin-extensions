+void ff_mediacodec_sw_buffer_copy_p010(AVCodecContext *avctx,
+                                       MediaCodecDecContext *s,
+                                       uint8_t *data,
+                                       size_t size,
+                                       FFAMediaCodecBufferInfo *info,
+                                       AVFrame *frame)
+{
+    int i;
+    uint8_t *src = NULL;
+
+    /* P010 is NV12 with 16-bit samples (10 bits in the high bits). All
+     * offsets are in bytes; a row is s->stride bytes. */
+    for (i = 0; i < 2; i++) {
+        int height;
+
+        src = data + info->offset;
+        if (i == 0) {
+            height = avctx->height;
+
+            src += s->crop_top * s->stride;
+            src += s->crop_left * 2;
+        } else if (i == 1) {
+            height = avctx->height / 2;
+
+            src += s->slice_height * s->stride;
+            src += s->crop_top * s->stride;
+            src += s->crop_left * 2;
+        }
+
+        if (frame->linesize[i] == s->stride) {
+            memcpy(frame->data[i], src, height * s->stride);
+        } else {
+            int j, width;
+            uint8_t *dst = frame->data[i];
+
+            if (i == 0)
+                width = FFMIN(frame->linesize[i], avctx->width * 2);
+            else
+                width = FFMIN(frame->linesize[i], FFALIGN(avctx->width, 2) * 2);
+
+            for (j = 0; j < height; j++) {
+                memcpy(dst, src, width);
+                src += s->stride;
+                dst += frame->linesize[i];
+            }
+        }
+    }
+
+    if (s->swap_uv)
+        swap_uv_plane(frame->data[1], frame->linesize[1],
+                      FFALIGN(avctx->width, 2) * 2, avctx->height / 2, 2);
+}
